# Database
DATABASE_URL=postgresql+asyncpg://callcenter:callcenter123@postgres:5432/callcenter
SYNC_DATABASE_URL=postgresql://callcenter:callcenter123@postgres:5432/callcenter

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sarvam AI
SARVAM_API_KEY=your-sarvam-api-key
DEFAULT_SARVAM_VOICE=meera
DEFAULT_SARVAM_TTS_MODEL=bulbul:v2

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Exotel
EXOTEL_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=your-exotel-subdomain
EXOTEL_CALLER_NUMBER=your-exotel-caller-number

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=ai-call-center-audio
AWS_REGION=ap-south-1

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
