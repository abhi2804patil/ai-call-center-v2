# Database
DATABASE_URL=postgresql+asyncpg://callcenter:callcenter123@postgres:5432/callcenter
SYNC_DATABASE_URL=postgresql://callcenter:callcenter123@postgres:5432/callcenter

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sarvam AI
SARVAM_API_KEY=your-sarvam-api-key
DEFAULT_SARVAM_VOICE=priya
DEFAULT_SARVAM_TTS_MODEL=bulbul:v3-beta

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=ai-call-center-audio
AWS_REGION=ap-south-1

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
SERVER_BASE_URL=https://your-domain.ngrok-free.app
